# Real SMTP preview. Copy to .env.smtp (ignored by Git) and fill locally.
# Requires authenticated SMTP with STARTTLS, normally port 587.
# Use a provider-authorized sender; never commit the username/password or API key.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
