# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO (VPS) - Notification Service
# ==============================================================================
# Copie este arquivo para .env.prod no servidor e preencha com as credenciais reais:
#   cp .env.prod.example .env.prod
# ATENÇÃO: NUNCA versione o arquivo .env.prod no Git!
# ==============================================================================

# Porta exposta no host para a aplicação (ex.: 8080 ou 8081 se houver proxy reverso NGINX/Caddy)
APP_DOMAIN=notifications.example.com

# ------------------------------------------------------------------------------
# Banco de Dados (MySQL 8.4 interno ao Docker - não acessível externamente)
# ------------------------------------------------------------------------------
DB_NAME=notification
DB_USER=notification_user
DB_PASSWORD=sua_senha_segura_do_banco_aqui
DB_ROOT_PASSWORD=sua_senha_segura_de_root_aqui

# ------------------------------------------------------------------------------
# Provedor SMTP Real (SendGrid, Mailgun, Amazon SES, Brevo, Hostinger, etc.)
# ------------------------------------------------------------------------------
# Endereço do servidor SMTP do provedor
SPRING_MAIL_HOST=smtp.seuprovedor.com

# Porta SMTP: 587 (STARTTLS recomendada) ou 465 (SSL)
SPRING_MAIL_PORT=587

# Usuário / API Key do provedor de e-mail
SPRING_MAIL_USERNAME=apikey_ou_usuario

# Senha / Secret Key do provedor de e-mail
SPRING_MAIL_PASSWORD=sua_chave_ou_senha_smtp

# Autenticação SMTP (normalmente "true" para provedores externos)
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true

# Habilita criptografia STARTTLS para envio seguro
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# E-mail remetente padrão exibido aos destinatários (deve ser um domínio validado no provedor)
MAIL_FROM=notificacoes@seudominio.com

# ------------------------------------------------------------------------------
# RabbitMQ (Mensageria e Filas de Notificação)
# ------------------------------------------------------------------------------
SPRING_RABBITMQ_USERNAME=notification
SPRING_RABBITMQ_PASSWORD=sua_senha_segura_do_rabbitmq_aqui
ADMIN_TOKEN=
# Primeiro administrador: configure apenas no bootstrap e remova a senha após criá-lo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TIMEOUT=30m
ADMIN_LOCK_MINUTES=15
SWAGGER_ENABLED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
RABBITMQ_PREFETCH=5
RABBITMQ_CONCURRENCY=2
RABBITMQ_MAX_CONCURRENCY=5
RABBITMQ_RETRY_1_TTL=10000
RABBITMQ_RETRY_2_TTL=30000
RABBITMQ_RETRY_3_TTL=120000

# Configurações adicionais (padrões da aplicação)
DB_URL=jdbc:mysql://localhost:3309/notification
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
API_TITLE=Notification Service API
API_DESCRIPTION=Transactional notification service
API_VERSION=1.0.0
RATE_LIMIT_PER_MINUTE=100
MAX_VARIABLES=50
VARIABLE_KEY_LENGTH=64
VARIABLE_VALUE_LENGTH=2000
REQUEST_BODY_MAX_BYTES=102400
TEMPLATE_CONTENT_MAX_LENGTH=50000
MAX_SCHEDULES_PER_APPLICATION=100
MINIMUM_CRON_SECONDS=60
NOTIFICATION_BATCH_SIZE=100
API_KEY_GRACE_HOURS=24
RETENTION_ENABLED=true
RETENTION_CRON=0 0 3 * * *
RETENTION_DELETE_DAYS=90
RETENTION_ANONYMIZE_DAYS=30
RETENTION_BATCH_SIZE=1000
RETENTION_PAUSE_MS=200
NOTIFICATION_MAX_ATTEMPTS=3
SCHEDULING_MAX_FUTURE_DAYS=365
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=100
SCHEDULER_MAX_LATENESS_SECONDS=3600
SCHEDULER_MISSED_OCCURRENCE_POLICY=SKIP_AND_GENERATE_LATEST
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=60000
RECONCILER_PENDING_SECONDS=120
RECONCILER_QUEUED_SECONDS=600
RECONCILER_PROCESSING_SECONDS=300
RECONCILER_BATCH_SIZE=100
RECONCILER_MAX_RECOVERIES=5
RABBITMQ_EXCHANGE=notification.exchange
RABBITMQ_QUEUE=notification.queue
RABBITMQ_ROUTING_KEY=notification.send
RABBITMQ_DLQ=notification.dlq
RABBITMQ_DLQ_ROUTING_KEY=notification.dlq
LOG_FORMAT=logstash
