# Copie para ".env" (que NÃO vai para o Git).
# Estes valores são só para desenvolvimento local.
# Na VPS use senhas fortes e outros valores.

MYSQL_ROOT_PASSWORD=root
DB_NAME=notification
DB_USER=notification
DB_PASSWORD=notification

# Usados pela aplicação (têm o mesmo padrão em application.yml)
DB_URL=jdbc:mysql://localhost:3306/notification
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@notification.local

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

